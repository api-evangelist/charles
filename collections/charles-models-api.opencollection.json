{
  "opencollection": "1.0.0",
  "info": {
    "name": "LINDAT Translation languages models API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns a list of available models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://lindat.mff.cuni.cz/services/translation/api/v2/models/"
          },
          "docs": "Returns a list of available models"
        },
        {
          "info": {
            "name": "Get model's details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://lindat.mff.cuni.cz/services/translation/api/v2/models/:model",
            "params": [
              {
                "name": "model",
                "value": "en-cs",
                "type": "path",
                "description": "model name"
              }
            ]
          },
          "docs": "Get model's details"
        },
        {
          "info": {
            "name": "Send text to be processed by the selected model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://lindat.mff.cuni.cz/services/translation/api/v2/models/:model",
            "params": [
              {
                "name": "model",
                "value": "en-cs",
                "type": "path",
                "description": "model name"
              },
              {
                "name": "src",
                "value": "en",
                "type": "query",
                "description": "src query param description"
              },
              {
                "name": "tgt",
                "value": "cs",
                "type": "query",
                "description": "tgt query param description"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "input_text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "It expects the text in variable called `input_text` and handles both \"application/x-www-form-urlencoded\" and \"multipart/form-data\" (for uploading text/plain files). If you don't provide src or tgt some will be chosen for you!"
        }
      ]
    }
  ],
  "bundled": true
}